# ============================================================
# Rich Buddy Platform — Environment Variables Example
# Copy this file to .env and fill in the values.
# ============================================================

# ------------------------------------------------------------
# Application
# ------------------------------------------------------------
APP_ENV=development
API_PORT=8080
API_KEY=your-internal-api-key

# ------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=rich_buddy
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=your-db-password

# ------------------------------------------------------------
# Redis
# ------------------------------------------------------------
REDIS_HOST_NAME=localhost:6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ------------------------------------------------------------
# JWT
# ------------------------------------------------------------
JWT_SECRET=your-super-secret-jwt-key

# ------------------------------------------------------------
# Agent (LLM Router / OpenAI-compatible endpoint)
# ------------------------------------------------------------
AGENT_BASE_URL=https://your-agent-router.example.com
AGENT_APIKEY=your-agent-api-key

# Model names registered on the agent router
AGENT_REGULAR=richBuddyRegular
AGENT_ANALYST=richBuddyAnalyst

# Max agentic tool-call rounds per turn (default: 10)
AGENT_MAX_TOOL_ROUNDS=10

# Optional: override default system prompts (leave empty to use built-in defaults)
AGENT_REGULAR_SYSTEM_PROMPT=
AGENT_ANALYST_SYSTEM_PROMPT=

# ------------------------------------------------------------
# Memory Service (LLM models used for extraction & summarisation)
# ------------------------------------------------------------
MEMORY_EXTRACTOR_MODEL=richBuddyRegular
MEMORY_SUMMARIZER_MODEL=richBuddyRegular

# ------------------------------------------------------------
# Sectors API (market data provider)
# ------------------------------------------------------------
SECTORS_API_URL=https://api.sectors.app
SECTORS_API_KEY=your-sectors-api-key

# ------------------------------------------------------------
# Midtrans (payment gateway)
# ------------------------------------------------------------
MIDTRANS_BASE_URL=https://api.sandbox.midtrans.com
MIDTRANS_API_KEY=your-midtrans-server-key

# ------------------------------------------------------------
# Storage / Filesystem
# ------------------------------------------------------------
# Driver: "local" or "s3"
FILESYSTEM_DRIVER=local
LOCAL_STORAGE_PATH=./storage
LOCAL_STORAGE_PATH_TRASH=./storage/trash

# AWS S3 (only required when FILESYSTEM_DRIVER=s3)
AWS_BUCKET=your-s3-bucket-name
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# ------------------------------------------------------------
# Seeder (only used by cmd/seeder)
# ------------------------------------------------------------
# Specify which seeder to run, e.g. "user" or leave empty to run all
SEEDER=